datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // "INCOME" | "EXPENSE"
  category    String
  description String?
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Budget {
  id       String @id @default(uuid())
  category String
  limit    Float
  userId   String
  user     User   @relation(fields: [userId], references: [id])
}